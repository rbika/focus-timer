{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Timer",
  "identifier": "com.rbika.focus-timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus Timer",
        "width": 280,
        "height": 180,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 500,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "release-notes",
        "title": "What’s New",
        "width": 420,
        "height": 360,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOUNENDQ2RjI3OEQ5MTIKUldRUzJYanlSdFNjczM0TXlnazEydWpwRXpQM3lmd0FnbmdkUEdnZ29ESDBTMG0zbFhFV2lUU2QK",
      "endpoints": [
        "https://github.com/rbika/focus-timer/releases/latest/download/latest.json"
      ]
    }
  }
}
